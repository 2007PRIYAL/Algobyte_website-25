# Frontend Environment Variables (Set in Vercel)
REACT_APP_API_URL=https://algobyte-website-25.onrender.com
REACT_APP_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Backend Environment Variables (Set in Render)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/algobyte?retryWrites=true&w=majority
NODE_ENV=production
